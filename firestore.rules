rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }
    match /questions/{questionId} {
      allow read: if resource.data.isPublished == true && resource.data.status == 'published';
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.keys().hasAll(['question', 'slug', 'topic', 'category', 'shortAnswer', 'detailedAnswer', 'importantPoints', 'followUpQuestions', 'tags', 'difficulty', 'isPublished', 'status', 'createdBy', 'updatedBy']) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.updatedBy == request.auth.uid;
      allow update: if isAdmin() && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow create, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}